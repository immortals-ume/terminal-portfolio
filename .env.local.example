# =============================================================================
# TERMINAL PORTFOLIO - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local and update with your actual values
# Never commit .env.local to version control!

# =============================================================================
# PERSONAL INFORMATION
# =============================================================================
# Your basic information (used in contact command and meta tags)
NEXT_PUBLIC_FULL_NAME="Kapil Srivastava"
NEXT_PUBLIC_EMAIL="kapil.srivastava712@gmail.com"
NEXT_PUBLIC_PHONE="Available upon request"
NEXT_PUBLIC_LOCATION="Gurugram, India"
NEXT_PUBLIC_ROLE="Software Development Engineer"
NEXT_PUBLIC_COMPANY="Lenskart"
NEXT_PUBLIC_WEBSITE="https://kapilsrivastava.dev"

# =============================================================================
# SOCIAL MEDIA & PROFILES
# =============================================================================
# Social media usernames (without @ or full URLs)
NEXT_PUBLIC_GITHUB_USERNAME="immortals-ume"
NEXT_PUBLIC_LINKEDIN_USERNAME="kapil-srivastava-72911-di"
NEXT_PUBLIC_TWITTER_USERNAME="your-twitter-handle"
NEXT_PUBLIC_LEETCODE_USERNAME="Ayanokoji09"
NEXT_PUBLIC_INSTAGRAM_USERNAME="your-instagram-handle"

# =============================================================================
# GITHUB INTEGRATION
# =============================================================================
# GitHub personal access token (optional but recommended for better API limits)
# Create at: https://github.com/settings/tokens
# Required scopes: public_repo, read:user
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"

# Featured repositories to highlight (comma-separated repo names)
NEXT_PUBLIC_FEATURED_REPOS="terminal-portfolio,project-alpha,awesome-app"

# =============================================================================
# CREDLY CERTIFICATION INTEGRATION
# =============================================================================
# Your Credly user ID or username for dynamic certification fetching
# Find this in your Credly profile URL: https://www.credly.com/users/YOUR_ID
NEXT_PUBLIC_CREDLY_USER_ID="kapil-srivastava.591fdf08"

# Credly API settings (optional)
CREDLY_API_CACHE_DURATION="3600"  # Cache duration in seconds (1 hour)

# =============================================================================
# ANALYTICS & TRACKING (Optional)
# =============================================================================
# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Vercel Analytics (automatically enabled on Vercel)
NEXT_PUBLIC_VERCEL_ANALYTICS="true"

# =============================================================================
# PERFORMANCE & OPTIMIZATION
# =============================================================================
# Matrix rain animation settings
NEXT_PUBLIC_MATRIX_SPEED="50"           # Animation speed (lower = faster)
NEXT_PUBLIC_MATRIX_DENSITY="0.8"       # Character density (0-1)
NEXT_PUBLIC_MATRIX_FONT_SIZE="14"      # Font size in pixels

# Terminal settings
NEXT_PUBLIC_TERMINAL_TYPING_SPEED="50"  # Typing animation speed (ms)
NEXT_PUBLIC_TERMINAL_CURSOR_BLINK="500" # Cursor blink rate (ms)

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Rate limiting for API endpoints
API_RATE_LIMIT_REQUESTS="100"          # Requests per window
API_RATE_LIMIT_WINDOW="900"            # Window duration in seconds (15 min)

# External API timeouts (in milliseconds)
GITHUB_API_TIMEOUT="5000"
CREDLY_API_TIMEOUT="8000"

# =============================================================================
# DEVELOPMENT & DEBUGGING
# =============================================================================
# Enable debug mode for additional logging
NEXT_PUBLIC_DEBUG_MODE="false"

# Enable performance monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING="false"

# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# =============================================================================
# SECURITY
# =============================================================================
# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Content Security Policy (CSP) settings
NEXT_PUBLIC_CSP_ENABLED="true"

# =============================================================================
# DEPLOYMENT SETTINGS
# =============================================================================
# Base URL for your deployed application
NEXT_PUBLIC_BASE_URL="https://kapilsrivastava.dev"

# Environment (development, staging, production)
NODE_ENV="production"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable specific features
NEXT_PUBLIC_ENABLE_MATRIX_BACKGROUND="true"
NEXT_PUBLIC_ENABLE_SOUND_EFFECTS="false"
NEXT_PUBLIC_ENABLE_EASTER_EGGS="true"
NEXT_PUBLIC_ENABLE_DARK_MODE_TOGGLE="false"
NEXT_PUBLIC_ENABLE_MOBILE_OPTIMIZATIONS="true"

# =============================================================================
# CONTACT FORM (if implemented)
# =============================================================================
# Email service configuration (e.g., SendGrid, Nodemailer)
EMAIL_SERVICE_API_KEY="your-email-service-api-key"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_TO="your-email@example.com"

# =============================================================================
# NOTES
# =============================================================================
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# 2. Keep sensitive data (API keys, tokens) without NEXT_PUBLIC_ prefix
# 3. Use quotes for values with spaces or special characters
# 4. Boolean values should be strings: "true" or "false"
# 5. Restart your development server after changing environment variables